{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  // mise.toml and the workflows under .github/workflows are picked up by the
  // built-in `mise` and `github-actions` managers with no configuration. The
  // `pre-commit` manager is opt-in, so it is switched on for the hook revs in
  // .pre-commit-config.yaml.
  "pre-commit": { enabled: true },

  timezone: "Europe/Warsaw",
  schedule: ["before 6am on monday"],

  packageRules: [
    {
      // These move together in practice, and every past bump here was a
      // single "Update tool versions" commit. One PR keeps that shape.
      matchManagers: ["mise"],
      groupName: "tool versions",
    },
  ],
}
